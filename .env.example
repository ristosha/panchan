# ── runtime ──
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# ── database (compose builds DATABASE_URL from these; bot also reads DATABASE_URL) ──
POSTGRES_USER=panchan
POSTGRES_PASSWORD=
POSTGRES_DB=panchan
DB_MAX_CONNECTIONS=8

# ── bot ──
BOT_TOKEN=
BOT_ADMIN_ID=
BOT_LOG_CHAT_ID=
BOT_MP_PARSE_CHAT_ID=
BOT_FILE_PREFIX=ppb-
BOT_GUIDE_URL=
ALLOWED_BOT_IDS=

# ── generation tuning (2-core / 3.8GB + swap) ──
GEN_CONCURRENCY=1
MEDIA_THREADS=2
AWARE_SCALE_CHUNK=2
AWARE_SCALE_FRAMES_LIMIT=150

# ── executables (provided by the image) ──
FFMPEG=ffmpeg
FFPROBE=ffprobe
IMAGE_MAGICK=magick

# ── retention (prune script) ──
SESSION_TTL_DAYS=30
USES_TTL_DAYS=3650
